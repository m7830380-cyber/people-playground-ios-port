<Project Sdk="Microsoft.NET.Sdk">
  <!-- Small runtime library the patched game assemblies call into instead of UnityEngine.Input,
       Process.Start, QualitySettings.vSyncCount, ... The iOS mod (shell/Assets/PPGiOS) drives it. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PPGShim</AssemblyName>
    <RootNamespace>PPGShim</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ManagedDir Condition="'$(ManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\People Playground\People Playground_Data\Managed</ManagedDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
